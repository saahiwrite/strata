<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logs are written to stdout as one JSON object per line so Promtail can ship them to Loki
  and the healer can read them. Run with the "plain-logs" profile for human-readable output.
-->
<configuration>
    <springProperty scope="context" name="SERVICE_NAME" source="spring.application.name" defaultValue="unknown-service"/>

    <springProfile name="plain-logs">
        <include resource="org/springframework/boot/logging/logback/base.xml"/>
    </springProfile>

    <springProfile name="!plain-logs">
        <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <includeContext>false</includeContext>
                <customFields>{"service":"${SERVICE_NAME}"}</customFields>
                <fieldNames>
                    <timestamp>timestamp</timestamp>
                    <version>[ignore]</version>
                    <levelValue>[ignore]</levelValue>
                </fieldNames>
                <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
                    <maxDepthPerThrowable>10</maxDepthPerThrowable>
                    <exclude>^org\.apache\.catalina\.</exclude>
                    <exclude>^org\.apache\.tomcat\.</exclude>
                    <exclude>^org\.springframework\.web\.filter\.</exclude>
                    <rootCauseFirst>true</rootCauseFirst>
                </throwableConverter>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="JSON"/>
        </root>
    </springProfile>
</configuration>
